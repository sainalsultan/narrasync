# Server lokal (dibaca oleh server saja, tidak pernah dikirim ke browser)
PORT=8787
HOST=127.0.0.1
# local = boleh menulis langsung ke folder project Motion Canvas
# hosted = ekspor hanya lewat unduhan
STUDIO_MODE=local
# Lokasi cache clip/efek suara dan project audio (default: folder repo)
# CACHE_DIR=./cache
# PROJECTS_DIR=./projects
# Path ffmpeg/ffprobe jika tidak ada di PATH
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# P1 – adapter TTS komersial (belum dipakai)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# ELEVENLABS_API_KEY=
